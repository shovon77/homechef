# Supabase
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Stripe - Test keys (for local dev only; NODE_ENV=development uses these exclusively)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_TEST_KEY=pk_test_xxx
STRIPE_SECRET_TEST_KEY=sk_test_xxx
STRIPE_WEBHOOK_TEST_SECRET=whsec_xxx

# Supabase Edge Functions: set APP_ENV=development in Supabase secrets for dev
# so functions use TEST keys only

# Stripe - Production (for yourhomechef.ca; NODE_ENV=production)
# Legacy STRIPE_* keys (sandbox values) are ignored in dev
EXPO_PUBLIC_STRIPE_PUBLISHABLE_PROD_KEY=pk_live_xxx
STRIPE_SECRET_PROD_KEY=sk_live_xxx
STRIPE_WEBHOOK_PROD_SECRET=whsec_xxx

# Fallback if PROD keys not set yet: STRIPE_PUBLISHABLE_KEY, STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET
