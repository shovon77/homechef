# E2E Test Environment
# Copy to .env.test and fill in values. .env.test is gitignored.

# Supabase (use same as .env for production with test-only emails)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Required for DB verification and cleanup
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional: Base URL override (default http://localhost:8081)
# E2E_BASE_URL=http://localhost:3000

# Optional: Google OAuth E2E (use a dedicated test Google account)
# GOOGLE_TEST_EMAIL=e2e-test-yourhomechef@gmail.com
# GOOGLE_TEST_PASSWORD=your_test_password
